<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash (before Flutter's first frame): Tar Road with the LOG mark
     centred, 96dp wide. Android 12+ uses values-v31 for the system splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
